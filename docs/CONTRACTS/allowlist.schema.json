{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dots validated tool allowlist v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "revision": {"type": "integer", "minimum": 0},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_id", "operation", "artifact_digest", "runtime_digest", "context_digest", "suite_digest", "validation_id", "validated_at", "evidence_ref", "evidence_digest"],
      "properties": {
        "tool_id": {"$ref": "#/$defs/identifier"},
        "operation": {"$ref": "#/$defs/identifier"},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "runtime_digest": {"$ref": "#/$defs/digest"},
        "context_digest": {"$ref": "#/$defs/digest"},
        "suite_digest": {"$ref": "#/$defs/digest"},
        "validation_id": {"$ref": "#/$defs/identifier"},
        "validated_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"},
        "evidence_ref": {"type": "string", "minLength": 1},
        "evidence_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
