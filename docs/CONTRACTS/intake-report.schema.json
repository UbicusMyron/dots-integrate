{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dots tool intake report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_ref", "environment_ref", "coverage", "dependencies", "issues", "trial", "outcome"],
  "properties": {
    "schema_version": {"const": 1},
    "source_ref": {"type": "string", "minLength": 1},
    "environment_ref": {"$ref": "#/$defs/nullableRef"},
    "coverage": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "name", "requirement", "status", "evidence"],
        "properties": {
          "kind": {"enum": ["python", "plugin", "gateway", "account", "file", "command", "implicit"]},
          "name": {"type": "string", "minLength": 1},
          "requirement": {"$ref": "#/$defs/nullableRef"},
          "status": {"enum": ["satisfied", "missing", "conflict", "unverified"]},
          "evidence": {"$ref": "#/$defs/evidence", "minItems": 1}
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["code", "message", "next_step"], "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "message": {"type": "string", "minLength": 1},
        "next_step": {"type": "string", "minLength": 1}
      }}
    },
    "trial": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "input_ref", "expected_ref", "result_ref", "evidence"],
      "properties": {
        "status": {"enum": ["not_run", "blocked", "failed", "passed"]},
        "input_ref": {"$ref": "#/$defs/nullableRef"},
        "expected_ref": {"$ref": "#/$defs/nullableRef"},
        "result_ref": {"$ref": "#/$defs/nullableRef"},
        "evidence": {"$ref": "#/$defs/evidence"}
      },
      "allOf": [{"if": {"properties": {"status": {"const": "passed"}}}, "then": {"properties": {
        "input_ref": {"type": "string"}, "expected_ref": {"type": "string"}, "result_ref": {"type": "string"}, "evidence": {"minItems": 1}
      }}}]
    },
    "outcome": {"enum": ["unverified", "blocked", "passed"]}
  },
  "allOf": [{
    "if": {"properties": {"outcome": {"const": "passed"}}},
    "then": {"properties": {
      "environment_ref": {"type": "string"},
      "dependencies": {"items": {"properties": {"status": {"const": "satisfied"}}}},
      "issues": {"maxItems": 0},
      "trial": {"properties": {"status": {"const": "passed"}}}
    }}
  }, {
    "if": {"anyOf": [
      {"properties": {"dependencies": {"contains": {"properties": {"status": {"enum": ["missing", "conflict"]}}}}}},
      {"properties": {"trial": {"properties": {"status": {"enum": ["blocked", "failed"]}}}}}
    ]},
    "then": {"properties": {"outcome": {"const": "blocked"}}}
  }],
  "$defs": {
    "nullableRef": {"type": ["string", "null"], "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
